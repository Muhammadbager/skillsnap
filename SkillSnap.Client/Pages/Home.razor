@page "/"
@inject ProjectService ProjectService
@inject SkillService SkillService
@inject ProfileService ProfileService

<PageTitle>SkillSnap · Show what you can build</PageTitle>

<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow">Portfolio, without the performance</p>
        <h1>Make your work<br /><em>easy to remember.</em></h1>
        <p class="hero-lede">A focused home for the projects you shipped, the skills you earned, and the story behind both.</p>
        <div class="hero-actions">
            <AuthorizeView>
                <Authorized><a class="button button-primary" href="dashboard">Open my studio <span>→</span></a></Authorized>
                <NotAuthorized><a class="button button-primary" href="register">Build your portfolio <span>→</span></a></NotAuthorized>
            </AuthorizeView>
            <a class="text-link" href="#work">Explore the community</a>
        </div>
    </div>
    <div class="hero-art" aria-hidden="true">
        <div class="orbit orbit-one"></div>
        <div class="orbit orbit-two"></div>
        <div class="art-card art-card-main"><span>01</span><strong>Ideas become<br />proof.</strong></div>
        <div class="art-card art-card-accent">C#</div>
        <div class="art-dot"></div>
    </div>
</section>

<section class="metric-strip" aria-label="SkillSnap highlights">
    <div><strong>@projects.Count.ToString("00")</strong><span>Projects in focus</span></div>
    <div><strong>@skills.Count.ToString("00")</strong><span>Skills being sharpened</span></div>
    <div><strong>@profiles.Count.ToString("00")</strong><span>Builders sharing work</span></div>
</section>

<section class="content-section" id="work">
    <div class="section-heading">
        <div><p class="eyebrow">Selected work</p><h2>Built, tested, shared.</h2></div>
        <p>Recent projects from the SkillSnap community. Sign in to publish your own.</p>
    </div>
    @if (loading)
    {
        <div class="loading-grid"><div></div><div></div></div>
    }
    else if (error is not null)
    {
        <div class="notice notice-error">@error</div>
    }
    else
    {
        <ProjectList Projects="projects" />
    }
</section>

<section class="content-section skill-section">
    <div class="section-heading compact">
        <div><p class="eyebrow">The toolkit</p><h2>Skills with receipts.</h2></div>
    </div>
    <SkillTags Skills="skills" />
</section>

@code {
    private List<ProjectDto> projects = [];
    private List<SkillDto> skills = [];
    private List<PortfolioDto> profiles = [];
    private bool loading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Task.WhenAll(LoadProjectsAsync(), LoadSkillsAsync(), LoadProfilesAsync());
        }
        catch (HttpRequestException)
        {
            error = "The API is taking a breather. Start SkillSnap.Api and refresh this page.";
        }
        finally { loading = false; }
    }

    private async Task LoadProjectsAsync() => projects = await ProjectService.GetProjectsAsync();
    private async Task LoadSkillsAsync() => skills = await SkillService.GetSkillsAsync();
    private async Task LoadProfilesAsync() => profiles = await ProfileService.GetProfilesAsync();
}
